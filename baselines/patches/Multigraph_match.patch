+    # --- FuseCC patch 4/4: opt-in resume from a saved checkpoint ---------------
+    # Upstream saves model.state_dict() only (no optimizer/epoch state) and has no
+    # resume path, so an interrupted run must retrain from epoch 0.
+    # These two env vars let us continue an
+    # interrupted run from its last checkpoint; both unset = EXACTLY upstream
+    # behaviour, so any normal launch is unaffected.
+    #   MAGNET_RESUME_FROM : path to model_<N>.pth to load before training
+    #   MAGNET_START_EPOCH : first epoch index to run (i.e. N+1)
+    # CAVEAT, must be reported: Adam moment estimates restart at the resume
+    # boundary (they were never checkpointed). The LR is unaffected because
+    # scheduler.step() is commented out upstream (line ~239), so the LR is constant
+    # at init_lr for the whole run and nothing schedule-related is lost.
+    resume_from = os.environ.get('MAGNET_RESUME_FROM')
+    start_epoch = int(os.environ.get('MAGNET_START_EPOCH', '0'))
+    if resume_from:
+        model.load_state_dict(torch.load(resume_from, map_location=device))
+        log.info(f"[FuseCC resume] loaded weights from {resume_from}")
+        log.info(f"[FuseCC resume] resuming at epoch {start_epoch} "
+                 f"(Adam state reset at this boundary; LR constant at "
+                 f"{params['init_lr']})")
+
+    epochs = trange(start_epoch, params['epochs'], leave=True, desc="Epoch")
